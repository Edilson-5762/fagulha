# Normalize all text files to LF in the repo and on checkout,
# regardless of the contributor's core.autocrlf setting.
* text=auto eol=lf

# Binary assets — never touch.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.otf   binary
*.avif  binary
*.mp4   binary
*.zip   binary
*.gz    binary
